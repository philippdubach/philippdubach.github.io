{
  "name": "social-poster-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for automated social media posting",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv namespace create POSTED_STATE",
    "secret:bluesky-handle": "wrangler secret put BLUESKY_HANDLE",
    "secret:bluesky-password": "wrangler secret put BLUESKY_APP_PASSWORD"
  },
  "dependencies": {
    "@social/shared": "file:../shared"
  }
}
